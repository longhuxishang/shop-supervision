{
  "name": "shop-supervision",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "龙湖熙上 · 商铺违规加建情况通报",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty",
    "thumbs": "node scripts/generate-thumbs.mjs",
    "thumbs:force": "node scripts/generate-thumbs.mjs --force",
    "cdn:compress": "elen compress",
    "cdn:upload": "elen cdn",
    "cdn:upload:dry": "elen cdn --dry-run",
    "release": "elen release",
    "pub": "elen pub"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@elenjs/cli": "^0.2.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "sass": "^1.92.1",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.5"
  }
}
